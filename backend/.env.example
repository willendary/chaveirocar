# Copie para .env e preencha. NUNCA commite o .env.
AMBIENTE=dev
HOST=0.0.0.0
PORTA=8787
URL_PUBLICA=http://localhost:8787

# Turso: crie com `turso db create chaveirocar-dev` e gere um token de leitura/escrita.
# Para desenvolvimento local sem Turso, use TURSO_URL=file:./var/chaveirocar.db
TURSO_URL=file:./var/chaveirocar.db
TURSO_TOKEN=

# Storage: local (desenvolvimento) ou s3 (Backblaze B2 / S3 compatível).
STORAGE_TIPO=local
DIR_STORAGE=./var/storage
S3_ENDPOINT=
S3_REGIAO=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail transacional. Obrigatório em produção; sem SMTP, links aparecem no log só em dev/teste.
SMTP_URL=
EMAIL_REMETENTE=ChaveiroCar <nao-responda@exemplo.com>

# CORS: origens separadas por vírgula. Aplicativos nativos não enviam Origin.
ORIGENS_PERMITIDAS=https://app.chaveirocar.com.br

# Limites
LIMITE_CORPO_MB=2
LIMITE_FOTO_MB=15
MAX_FOTOS_POR_REGISTRO=20
MAX_CONVITES_ABERTOS=20
RETENCAO_MUDANCAS_DIAS=180

# Produção: nunca exponha token de convite/reset na resposta.
EXPOR_TOKEN_DEV=false
