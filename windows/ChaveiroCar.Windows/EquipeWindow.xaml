<Window x:Class="ChaveiroCar.Windows.EquipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Equipe e Permissões"
        Height="640" Width="880" MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Equipe e Controle de Acessos" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Gerencie os colaboradores da empresa e convide novos membros."
                           Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" x:Name="PainelConvite" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                CornerRadius="10" Margin="20,16,20,0" Padding="16,12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="E-mail do colaborador:" VerticalAlignment="Center"
                           Foreground="{StaticResource CorTextoSecundario}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button DockPanel.Dock="Right" x:Name="Convidar" Content="Enviar convite"
                        Style="{StaticResource BotaoPrimario}" Click="Convidar_Click"/>
                <ComboBox DockPanel.Dock="Right" x:Name="PapelNovo" Width="170" Margin="10,0,10,0" SelectedIndex="0">
                    <ComboBoxItem Content="Colaborador" Tag="colaborador"/>
                    <ComboBoxItem Content="Administrador" Tag="administrador"/>
                    <ComboBoxItem Content="Somente leitura" Tag="leitor"/>
                </ComboBox>
                <TextBox x:Name="EmailConvite"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                CornerRadius="10" Margin="20,14,20,12" Padding="12">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="  Membros Ativos  " Padding="12,6" FontWeight="SemiBold">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" x:Name="AcoesMembro" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="PapelMembro" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Colaborador" Tag="colaborador"/>
                                <ComboBoxItem Content="Administrador" Tag="administrador"/>
                                <ComboBoxItem Content="Somente leitura" Tag="leitor"/>
                            </ComboBox>
                            <Button Content="Alterar permissão" Click="AlterarPapel_Click" Margin="8,0,0,0"/>
                            <Button Content="Remover acesso" Style="{StaticResource BotaoPerigo}" Click="RemoverMembro_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="Membros" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="260"/>
                                <DataGridTextColumn Header="Permissão" Binding="{Binding PapelFormatado}" Width="150"/>
                                <DataGridTextColumn Header="Membro desde" Binding="{Binding DesdeFormatado}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem x:Name="AbaConvites" Header="  Convites Enviados  " Padding="12,6" FontWeight="SemiBold">
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Top" Content="Cancelar convite selecionado"
                                Style="{StaticResource BotaoPerigo}" Click="CancelarConvite_Click"
                                HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <DataGrid x:Name="Convites" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="E-mail convidado" Binding="{Binding Email}" Width="280"/>
                                <DataGridTextColumn Header="Permissão" Binding="{Binding PapelFormatado}" Width="160"/>
                                <DataGridTextColumn Header="Situação" Binding="{Binding SituacaoFormatada}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <DockPanel x:Name="PainelCodigo" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="CopiarCodigo" Content="Copiar código"
                            Click="CopiarCodigo_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                    <TextBox x:Name="CodigoConvite" IsReadOnly="True" Visibility="Collapsed"/>
                </DockPanel>
                <TextBlock x:Name="Status" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
