<Window x:Class="ChaveiroCar.Windows.FichaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Ficha Técnica"
        Height="760" Width="820" MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Ficha Técnica de Veículo / Equipamento" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Documente sistema imobilizador, chip, chave, telecomando e procedimento passo a passo."
                           Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,12">
            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}"
                    BorderThickness="1" CornerRadius="10" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="Identificação do Veículo / Equipamento" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource CorTextoPrimario}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Equipamento" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Equipamento"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="Marca" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Marca"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Modelo" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Modelo"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="Ano" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Ano"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Sistema" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Sistema"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="Origem" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Origem"/>
                        </StackPanel>
                        <CheckBox x:Name="Confirmado" Content="Informação técnica revisada e confirmada"
                                  FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,10"/>
                    </UniformGrid>

                    <TextBlock Text="Especificações de Chave e Transponder" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource CorTextoPrimario}" Margin="0,10,0,10"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Chip / transponder" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Chip"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="Lâmina / chave" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Chave"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Telecomando" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Telecomando"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="Frequência" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Frequencia"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Descrição geral" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,4,0,4"/>
                    <TextBox x:Name="Descricao" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="Funções suportadas" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,10,0,4"/>
                    <TextBox x:Name="Funcoes" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="Avisos importantes" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,10,0,4"/>
                    <TextBox x:Name="Avisos" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="Manual / procedimento passo a passo" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,10,0,4"/>
                    <TextBox x:Name="Manual" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="Fotos da Ficha Técnica" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource CorTextoPrimario}" Margin="0,14,0,8"/>
                    <TextBlock Text="Fotos sincronizadas" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                    <ListBox x:Name="FotosExistentes" Height="80" DisplayMemberPath="Legenda"
                             BorderBrush="{StaticResource CorBorda}"/>
                    <Button Content="Abrir foto selecionada" Click="AbrirFoto_Click" HorizontalAlignment="Left" Margin="0,6,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Categoria das novas fotos" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CategoriaFoto" SelectedIndex="1">
                                <ComboBoxItem Content="Veículo" Tag="CARRO"/>
                                <ComboBoxItem Content="Procedimento" Tag="PROCEDIMENTO"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Legenda (opcional)" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4"/>
                            <TextBox x:Name="LegendaFoto"/>
                        </StackPanel>
                    </UniformGrid>

                    <ListBox x:Name="FotosNovas" Height="90" DisplayMemberPath="Legenda"
                             BorderBrush="{StaticResource CorBorda}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Adicionar fotos…" Click="AdicionarFotos_Click"/>
                        <Button Content="Remover foto nova" Style="{StaticResource BotaoPerigo}" Click="RemoverFoto_Click" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="Erro" Foreground="{StaticResource CorPerigo}"
                               FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Width="110" Margin="0,0,10,0"/>
                <Button Content="Salvar ficha técnica" IsDefault="True" Style="{StaticResource BotaoPrimario}"
                        Width="160" Click="Salvar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
