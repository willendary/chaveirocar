<Window x:Class="ChaveiroCar.Windows.FichaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha técnica" Height="720" Width="760" MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,12">
                <TextBlock Text="Veículo / equipamento" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Equipamento"/>
                        <TextBox x:Name="Equipamento"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Marca"/>
                        <TextBox x:Name="Marca"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Modelo"/>
                        <TextBox x:Name="Modelo"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Ano"/>
                        <TextBox x:Name="Ano"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Sistema"/>
                        <TextBox x:Name="Sistema"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Origem"/>
                        <TextBox x:Name="Origem"/>
                    </StackPanel>
                    <CheckBox x:Name="Confirmado" Content="Informação confirmada" VerticalAlignment="Center" Margin="0,10,0,8"/>
                </UniformGrid>
                <TextBlock Text="Dados técnicos" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Chip / transponder"/>
                        <TextBox x:Name="Chip"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Chave"/>
                        <TextBox x:Name="Chave"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Telecomando"/>
                        <TextBox x:Name="Telecomando"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Frequência"/>
                        <TextBox x:Name="Frequencia"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="Descrição"/>
                <TextBox x:Name="Descricao" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Funções" Margin="0,6,0,0"/>
                <TextBox x:Name="Funcoes" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Avisos" Margin="0,6,0,0"/>
                <TextBox x:Name="Avisos" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Manual / procedimento" Margin="0,6,0,0"/>
                <TextBox x:Name="Manual" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Fotos da ficha" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <TextBlock Text="Fotos sincronizadas" Margin="0,0,0,4"/>
                <ListBox x:Name="FotosExistentes" Height="80" DisplayMemberPath="Legenda"/>
                <Button Content="Abrir foto selecionada" Click="AbrirFoto_Click" HorizontalAlignment="Left" Margin="0,4,0,6"/>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Categoria das novas fotos"/>
                        <ComboBox x:Name="CategoriaFoto" SelectedIndex="1">
                            <ComboBoxItem Content="Veículo" Tag="CARRO"/>
                            <ComboBoxItem Content="Procedimento" Tag="PROCEDIMENTO"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Legenda (opcional)"/>
                        <TextBox x:Name="LegendaFoto"/>
                    </StackPanel>
                </UniformGrid>
                <ListBox x:Name="FotosNovas" Height="90" DisplayMemberPath="Legenda"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Adicionar fotos…" Click="AdicionarFotos_Click"/>
                    <Button Content="Remover foto nova" Click="RemoverFoto_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Erro" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" LastChildFill="False">
            <Button Content="Cancelar" IsCancel="True" Width="100" Margin="0,0,8,0"/>
            <Button Content="Salvar" IsDefault="True" Width="100" Click="Salvar_Click"/>
        </DockPanel>
    </Grid>
</Window>
