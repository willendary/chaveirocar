<Window x:Class="ChaveiroCar.Windows.JanelaAtualizacao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização do ChaveiroCar"
        Width="500" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Institucional Dark Navy -->
        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="20,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource CorPrimaria}" Margin="0,0,12,0">
                    <TextBlock Text="CC" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Atualização do ChaveiroCar" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="Nova versão disponível" Foreground="#FF94A3B8" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conteúdo Central -->
        <Grid Grid.Row="1" Margin="24,20,24,16">
            <!-- Painel 1: Pergunta inicial -->
            <StackPanel x:Name="PainelInicio" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock x:Name="TxtDescricao" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                           Foreground="{StaticResource CorTextoPrimario}" Margin="0,0,0,12"/>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="TxtInfoArquivo" Text="Arquivo: ChaveiroCar-Setup.exe" Foreground="{StaticResource CorTextoSecundario}" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtInfoTamanho" Text="Tamanho aproximado: ~60 MB" Foreground="{StaticResource CorTextoSecundario}" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Painel 2: Download em andamento -->
            <StackPanel x:Name="PainelProgresso" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Baixando arquivos da nova versão..." FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource CorTextoPrimario}" Margin="0,0,0,10"/>
                <ProgressBar x:Name="BarraProgresso" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="TxtProgressoPercentual" DockPanel.Dock="Left" Text="0%" FontWeight="Bold"
                               Foreground="{StaticResource CorPrimaria}" FontSize="13"/>
                    <TextBlock x:Name="TxtProgressoDetalhe" DockPanel.Dock="Right" Text="0 MB de 0 MB"
                               Foreground="{StaticResource CorTextoSecundario}" FontSize="12"/>
                </DockPanel>
            </StackPanel>

            <!-- Painel 3: Concluído -->
            <StackPanel x:Name="PainelConcluido" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#D1FAE5" Margin="0,0,8,0">
                        <TextBlock Text="✓" Foreground="{StaticResource CorPrimaria}" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Download concluído com sucesso!" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="O aplicativo precisa ser fechado agora para concluir a atualização e substituir os arquivos antigos pela nova versão."
                           TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,6"/>
                <TextBlock Text="Deseja reiniciar e concluir a atualização agora?"
                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource CorTextoPrimario}"/>
            </StackPanel>
        </Grid>

        <!-- Barra Inferior de Ações -->
        <Border Grid.Row="2" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBordaSuave}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <!-- Botões Painel Início -->
                <StackPanel x:Name="BotoesInicio" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Visible">
                    <Button Content="Mais tarde" Click="Cancelar_Click" Margin="0,0,8,0"/>
                    <Button Content="Baixar e Atualizar" Click="Baixar_Click" Style="{StaticResource BotaoPrimario}"/>
                </StackPanel>

                <!-- Botões Painel Progresso -->
                <StackPanel x:Name="BotoesProgresso" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Cancelar download" Click="CancelarDownload_Click"/>
                </StackPanel>

                <!-- Botões Painel Concluído -->
                <StackPanel x:Name="BotoesConcluido" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Depois" Click="Fechar_Click" Margin="0,0,8,0"/>
                    <Button Content="Reiniciar e Concluir" Click="InstalarAgora_Click" Style="{StaticResource BotaoPrimario}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
