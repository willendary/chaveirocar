<Window x:Class="ChaveiroCar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar" Height="520" Width="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="Busca" Width="220" Margin="0,0,8,0" KeyDown="Busca_KeyDown"/>
            <Button Content="Pesquisar" Click="Pesquisar_Click"/>
            <Button Content="Sincronizar" Click="Sincronizar_Click" Margin="8,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grade" AutoGenerateColumns="True"
                  IsReadOnly="True" CanUserAddRows="False"/>
    </Grid>
</Window>
