<Window x:Class="ChaveiroCar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Sistema de Gestão"
        Height="780" Width="1320" MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR LATERAL ESCURA ==================== -->
        <Border Grid.Column="0" Background="{StaticResource CorSidebar}" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Topo: Marca Oficial + Empresa -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="52" Height="38" CornerRadius="9" Background="#393A3C"
                                BorderBrush="#525458" BorderThickness="1" Padding="5" Margin="0,0,12,0">
                            <Image x:Name="LogoCabecalho" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ChaveiroCar" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Gestão Profissional" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="EMPRESA ATIVA" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,5"/>
                    <ComboBox x:Name="Empresas" SelectionChanged="Empresa_Mudou" Margin="0,0,0,14"/>

                    <!-- Alternador rápido de área (Veicular / Residencial) -->
                    <StackPanel x:Name="PainelSeletorAreaSidebar" Margin="0,0,0,4">
                        <TextBlock Text="ÁREA DE TRABALHO" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                        <Border Background="#1E293B" CornerRadius="8" Padding="3">
                            <UniformGrid Columns="2">
                                <Button x:Name="BtnAreaVeicular" Content="Veicular" Click="SelecionarAreaVeicular_Click"
                                        Style="{StaticResource BotaoSidebar}" MinHeight="30" Padding="6,4"
                                        HorizontalContentAlignment="Center" FontSize="12"/>
                                <Button x:Name="BtnAreaResidencial" Content="Residencial" Click="SelecionarAreaResidencial_Click"
                                        Style="{StaticResource BotaoSidebar}" MinHeight="30" Padding="6,4"
                                        HorizontalContentAlignment="Center" FontSize="12"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé da Sidebar: Gestão + Usuário -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,16">
                    <Border Height="1" Background="#1E293B" Margin="4,0,4,10"/>
                    <TextBlock Text="ADMINISTRAÇÃO" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="8,0,0,6"/>

                    <Button Style="{StaticResource BotaoSidebar}" Click="Equipe_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M16,11 C17.66,11 19,9.66 19,8 C19,6.34 17.66,5 16,5 C14.34,5 13,6.34 13,8 C13,9.66 14.34,11 16,11 Z M8,11 C9.66,11 11,9.66 11,8 C11,6.34 9.66,5 8,5 C6.34,5 5,6.34 5,8 C5,9.66 6.34,11 8,11 Z M8,13 C5.67,13 1,14.17 1,16.5 V19 H15 V16.5 C15,14.17 10.33,13 8,13 Z M16,13 C15.71,13 15.38,13.02 15.03,13.05 C16.19,13.89 17,15.02 17,16.5 V19 H23 V16.5 C23,14.17 18.33,13 16,13 Z"
                                  Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Equipe e acessos" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotaoSidebar}" Click="Plano_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20,4 H4 C2.89,4 2,4.89 2,6 V18 C2,19.11 2.89,20 4,20 H20 C21.11,20 22,19.11 22,18 V6 C22,4.89 21.11,4 20,4 Z M20,18 H4 V12 H20 V18 Z M20,8 H4 V6 H20 V8 Z"
                                  Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Plano e módulos" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotaoSidebar}" Click="VerificarAtualizacoes_Click" Margin="0,0,0,10">
                        <DockPanel Width="196" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 H17.65 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 H20 V4 L17.65,6.35 Z"
                                      Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Atualizações" Foreground="#CBD5E1"/>
                            </StackPanel>
                            <Border x:Name="PontoAtualizacaoSidebar" DockPanel.Dock="Right" Background="#0D9488"
                                    CornerRadius="99" Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="Nova" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <!-- Card de Perfil do Usuário -->
                    <Border Background="#1E293B" CornerRadius="10" Padding="11,10" BorderBrush="#334155" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Click="Sair_Click" ToolTip="Sair da conta"
                                    Background="Transparent" BorderThickness="0" Padding="6,4" MinHeight="28"
                                    VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Hand">
                                <TextBlock Text="Sair" Foreground="#F87171" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="#0D9488"
                                    Margin="0,0,9,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtInicialUsuario" Text="C" Foreground="White" FontWeight="Bold"
                                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="EmailUsuario" Text="Sessão ativa" Foreground="#F8FAFC"
                                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtVersaoApp" Text="Desktop v1.15.0" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Menu Principal de Navegação -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,4,14,4">
                    <StackPanel>
                        <TextBlock Text="NAVEGAÇÃO" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="8,6,0,6"/>

                        <Button x:Name="BtnNavInicio" Style="{StaticResource BotaoSidebarAtivo}" Click="NavInicio_Click" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10,20 V14 H14 V20 H19 V12 H22 L12,3 L2,12 H5 V20 H10 Z"
                                      Fill="#5EEAD4" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Início e Modalidades" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavAtendimentos" Style="{StaticResource BotaoSidebar}" Click="NavAtendimentos_Click" Margin="0,0,0,4">
                            <DockPanel Width="196" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3,13 H5 V11 H3 V13 Z M3,17 H5 V15 H3 V17 Z M3,9 H5 V7 H3 V9 Z M7,13 H21 V11 H7 V13 Z M7,17 H21 V15 H7 V17 Z M7,7 V9 H21 V7 H7 Z"
                                          Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Atendimentos" Foreground="#E2E8F0"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeAtendimentos" Text="0" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <Button x:Name="BtnNavFichario" Style="{StaticResource BotaoSidebar}" Click="NavFichario_Click" Margin="0,0,0,4">
                            <DockPanel Width="196" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M18,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V4 C20,2.9 19.1,2 18,2 Z M6,4 H11 V12 L8.5,10.5 L6,12 V4 Z"
                                          Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fichário Inteligente" Foreground="#E2E8F0"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeFichario" Text="0" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <Button x:Name="BtnNavFichas" Style="{StaticResource BotaoSidebar}" Click="NavFichas_Click" Margin="0,0,0,4">
                            <DockPanel Width="196" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M14,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.89,22 5.99,22 H18 C19.1,22 20,21.1 20,20 V8 L14,2 Z M16,18 H8 V16 H16 V18 Z M16,14 H8 V12 H16 V14 Z M13,9 V3.5 L18.5,9 H13 Z"
                                          Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fichas e Manuais" Foreground="#E2E8F0"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeFichas" Text="0" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <Button x:Name="BtnNavConflitos" Style="{StaticResource BotaoSidebar}" Click="NavConflitos_Click"
                                Margin="0,6,0,4" Visibility="Collapsed">
                            <DockPanel Width="196" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M1,21 H23 L12,2 L1,21 Z M13,18 H11 V16 H13 V18 Z M13,14 H11 V10 H13 V14 Z"
                                          Fill="#F59E0B" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Conflitos de Sincronia" Foreground="#FDE68A"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#78350F" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeConflitos" Text="0" Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== ÁREA PRINCIPAL DE TRABALHO ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior Limpa do Workspace -->
            <Border Grid.Row="0" Background="{StaticResource CorSuperficie}"
                    BorderBrush="{StaticResource CorBordaSuave}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTituloPagina" Text="Painel Inicial" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource CorTextoPrimario}" VerticalAlignment="Center"/>
                                <Border x:Name="SeloModalidadeAtiva" Background="{StaticResource CorPrimariaSuave}"
                                        CornerRadius="6" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtModalidadeAtiva" Text="Veicular" Foreground="{StaticResource CorPrimariaEscura}"
                                               FontWeight="Bold" FontSize="11.5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtSubtituloPagina" Text="Escolha a modalidade ou acesse rapidamente os registros da empresa."
                                       Foreground="{StaticResource CorTextoMudo}" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status da Nuvem + Sincronizar -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="99"
                                Padding="11,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource CorPrimaria}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusNuvem" Text="Nuvem ativa" Foreground="{StaticResource CorTextoSecundario}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSincronizar" Content="Sincronizar" Click="SincronizarManual_Click"
                                Margin="0,0,10,0" ToolTip="Sincronizar atendimentos, fichas e fotos com a nuvem agora"/>

                        <Button x:Name="BtnAtualizacaoDisponivel" Visibility="Collapsed" Content="Atualizar app"
                                Click="AtualizarApp_Click" Style="{StaticResource BotaoCompacto}"
                                Background="#FEF3C7" BorderBrush="#FCD34D" Foreground="#92400E"
                                Margin="0,0,10,0"/>

                        <Button x:Name="BtnAcaoPrincipalTopo" Content="+ Novo atendimento" Click="AcaoPrincipalTopo_Click"
                                Style="{StaticResource BotaoPrimario}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== CONTEÚDO PRINCIPAL ==================== -->
            <Grid Grid.Row="1">

                <!-- 1. PAINEL INICIAL / ESCOLHA DE MODALIDADE + KPIs -->
                <ScrollViewer x:Name="PainelEscolhaModalidade" VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="1060" HorizontalAlignment="Stretch">
                        <!-- Hero Banner Institucional -->
                        <Border CornerRadius="14" Padding="26,22" Margin="0,0,0,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F172A" Offset="0"/>
                                    <GradientStop Color="#134E4A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="660">
                                    <TextBlock Text="PAINEL DE OPERAÇÃO" Foreground="#5EEAD4" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Qual área você vai usar agora?" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,4,0,5"/>
                                    <TextBlock Text="Acesse atendimentos, memória técnica do fichário e manuais offline direto pela modalidade desejada."
                                               Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8"
                                            Padding="12,6" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <TextBlock x:Name="ResumoPlanoEscolha" Text="Plano ativo" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Content="Gerenciar plano e módulos" Click="Plano_Click" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Cartões de Indicadores (KPIs em tempo real) -->
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,0"
                                    Cursor="Hand" MouseLeftButtonUp="KpiVeicular_Click">
                                <StackPanel>
                                    <TextBlock Text="VEICULAR" Foreground="{StaticResource CorTextoMudo}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiVeicular" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource CorTextoPrimario}" Margin="0,4,0,2"/>
                                    <TextBlock Text="atendimentos registrados" Foreground="{StaticResource CorTextoMudo}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,0"
                                    Cursor="Hand" MouseLeftButtonUp="KpiResidencial_Click">
                                <StackPanel>
                                    <TextBlock Text="RESIDENCIAL" Foreground="{StaticResource CorTextoMudo}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiResidencial" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource CorTextoPrimario}" Margin="0,4,0,2"/>
                                    <TextBlock Text="atendimentos registrados" Foreground="{StaticResource CorTextoMudo}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,0"
                                    Cursor="Hand" MouseLeftButtonUp="KpiFichas_Click">
                                <StackPanel>
                                    <TextBlock Text="FICHAS E MANUAIS" Foreground="{StaticResource CorTextoMudo}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiFichas" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource CorPrimaria}" Margin="0,4,0,2"/>
                                    <TextBlock Text="disponíveis offline" Foreground="{StaticResource CorTextoMudo}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Cursor="Hand" MouseLeftButtonUp="KpiPendentes_Click">
                                <StackPanel>
                                    <TextBlock Text="A RECEBER" Foreground="{StaticResource CorTextoMudo}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiPendentes" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource CorAlerta}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtKpiPendentesValor" Text="R$ 0,00 pendente" Foreground="{StaticResource CorTextoMudo}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Cartões de Entrada por Modalidade -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="14" Padding="24,22">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="10" Background="#CCFBF1" Margin="0,0,12,0">
                                                <Path Data="M18.92,6.01 C18.72,5.42 18.16,5 17.5,5 H6.5 C5.84,5 5.29,5.42 5.08,6.01 L3,12 V20 C3,20.55 3.45,21 4,21 H5 C5.55,21 6,20.55 6,20 V19 H18 V20 C18,20.55 18.45,21 19,21 H20 C20.55,21 21,20.55 21,20 V12 L18.92,6.01 Z M6.5,16 C5.67,16 5,15.33 5,14.5 C5,13.67 5.67,13 6.5,13 C7.33,13 8,13.67 8,14.5 C8,15.33 7.33,16 6.5,16 Z M17.5,16 C16.67,16 16,15.33 16,14.5 C16,13.67 16.67,13 17.5,13 C18.33,13 19,13.67 19,14.5 C19,15.33 18.33,16 17.5,16 Z M5,11 L6.5,6.5 H17.5 L19,11 H5 Z"
                                                      Fill="#0F766E" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Veicular" FontSize="19" FontWeight="Bold" Foreground="{StaticResource CorTextoPrimario}"/>
                                                <TextBlock Text="Automotivo e imobilizadores" Foreground="{StaticResource CorTextoMudo}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" x:Name="BadgeVeicularEscolha" Background="{StaticResource CorPrimariaSuave}"
                                                CornerRadius="99" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBadgeVeicularEscolha" Text="Disponível no plano"
                                                       Foreground="{StaticResource CorPrimariaEscura}" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Chaves codificadas, chips/transponders, telecomandos, busca automática por placa, abertura veicular, fichário de modelos e manuais offline."
                                               Foreground="{StaticResource CorTextoSecundario}" FontSize="13" TextWrapping="Wrap" MinHeight="52" Margin="0,0,0,18"/>
                                    <Button x:Name="BtnEntrarVeicular" Content="Entrar em Veicular" Style="{StaticResource BotaoPrimario}"
                                            Height="40" Click="EntrarVeicular_Click" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnConsultaVeicular" Content="Fichas técnicas e manuais veiculares"
                                            Height="38" Click="ConsultarVeicularInicial_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                    BorderThickness="1" CornerRadius="14" Padding="24,22">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="10" Background="#CCFBF1" Margin="0,0,12,0">
                                                <Path Data="M10,20 V14 H14 V20 H19 V12 H22 L12,3 L2,12 H5 V20 H10 Z"
                                                      Fill="#0F766E" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Residencial" FontSize="19" FontWeight="Bold" Foreground="{StaticResource CorTextoPrimario}"/>
                                                <TextBlock Text="Imóveis, portas e fechaduras" Foreground="{StaticResource CorTextoMudo}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" x:Name="BadgeResidencialEscolha" Background="{StaticResource CorPrimariaSuave}"
                                                CornerRadius="99" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBadgeResidencialEscolha" Text="Disponível no plano"
                                                       Foreground="{StaticResource CorPrimariaEscura}" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Aberturas residenciais, cilindros, travas tetra/multiponto, fechaduras digitais, controles de portão e histórico organizado por imóvel."
                                               Foreground="{StaticResource CorTextoSecundario}" FontSize="13" TextWrapping="Wrap" MinHeight="52" Margin="0,0,0,18"/>
                                    <Button x:Name="BtnEntrarResidencial" Content="Entrar em Residencial" Style="{StaticResource BotaoPrimario}"
                                            Height="40" Click="EntrarResidencial_Click" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnConsultaResidencial" Content="Fichas e manuais residenciais"
                                            Height="38" Click="ConsultarResidencialInicial_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. WORKSPACE DE ATENDIMENTOS (Master-Detail Profissional) -->
                <Grid x:Name="PainelAtendimentos" Margin="20,16,20,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Busca e Filtros -->
                    <Border Grid.Row="0" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="310" Margin="0,0,8,0">
                                    <TextBox x:Name="Busca" Padding="10,7,32,7" TextChanged="Busca_TextChanged" KeyDown="Busca_KeyDown"
                                             ToolTip="Busca instantânea (sem acento) em placa, veículo, fechadura, cliente, defeito, solução, código e chip"/>
                                    <TextBlock x:Name="PlaceholderBusca" Text="Buscar placa, veículo, cliente, defeito, código…"
                                               Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,30,0"
                                               IsHitTestVisible="False"/>
                                    <Button x:Name="BtnLimparBusca" Content="✕" Click="LimparBusca_Click" Visibility="Collapsed"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                            BorderThickness="0" Foreground="#64748B" Padding="6,2" MinHeight="24" Margin="0,0,4,0"/>
                                </Grid>

                                <ComboBox x:Name="FiltroPeriodo" Width="148" SelectedIndex="0" SelectionChanged="FiltroPeriodo_Mudou" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Todo o período" Tag="TODOS"/>
                                    <ComboBoxItem Content="Últimos 30 dias" Tag="30"/>
                                    <ComboBoxItem Content="Últimos 90 dias" Tag="90"/>
                                    <ComboBoxItem Content="Este ano" Tag="ANO"/>
                                </ComboBox>

                                <Button x:Name="BtnFiltroPagoTodos" Content="Todos" Style="{StaticResource BotaoChipAtivo}"
                                        Click="FiltroPagamento_Click" Tag="TODOS" Margin="0,0,4,0"/>
                                <Button x:Name="BtnFiltroPagoSim" Content="Pagos" Style="{StaticResource BotaoChip}"
                                        Click="FiltroPagamento_Click" Tag="PAGOS" Margin="0,0,4,0"/>
                                <Button x:Name="BtnFiltroPagoPendente" Content="A receber" Style="{StaticResource BotaoChip}"
                                        Click="FiltroPagamento_Click" Tag="PENDENTES"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtContadorLista" Text="0 registros" Foreground="{StaticResource CorTextoMudo}"
                                           FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="BtnNovoAtendimento" Content="+ Novo" Click="Novo_Click"
                                        Style="{StaticResource BotaoPrimario}" Padding="14,6" MinHeight="32"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Split: Tabela à Esquerda + Inspetor de Detalhes à Direita -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tabela de Atendimentos -->
                        <Border Grid.Column="0" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                BorderThickness="1" CornerRadius="12" Padding="0">
                            <Grid>
                                <DataGrid x:Name="Grade" AutoGenerateColumns="False" BorderThickness="0"
                                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                          SelectionChanged="Grade_SelectionChanged"
                                          MouseDoubleClick="Grade_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}" Width="92"/>
                                        <DataGridTextColumn x:Name="ColPlacaOuFechadura" Header="Placa / Fechadura" Binding="{Binding PlacaOuFechadura}" Width="125"/>
                                        <DataGridTextColumn x:Name="ColVeiculoOuLocal" Header="Veículo / Local" Binding="{Binding IdentificacaoPrincipal}" Width="190"/>
                                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="130"/>
                                        <DataGridTextColumn Header="Serviços" Binding="{Binding TiposFormatados}" Width="*"/>
                                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorFormatado}" Width="98"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding PagoFormatado}" Width="88"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Estado Vazio Elegante -->
                                <StackPanel x:Name="PainelVazioAtendimentos" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="Collapsed" MaxWidth="360">
                                    <TextBlock Text="Nenhum atendimento encontrado" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource CorTextoPrimario}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtVazioAtendimentosSub"
                                               Text="Registre o primeiro atendimento desta área ou ajuste os filtros de pesquisa."
                                               Foreground="{StaticResource CorTextoMudo}" FontSize="13" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,6,0,14"/>
                                    <Button Content="+ Registrar novo atendimento" Click="Novo_Click"
                                            Style="{StaticResource BotaoPrimario}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Inspetor Lateral de Detalhes do Atendimento -->
                        <Border Grid.Column="2" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <!-- Estado sem seleção -->
                                <StackPanel x:Name="PainelDetalheVazio" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#F1F5F9" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <Path Data="M14,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V8 L14,2 Z M16,18 H8 V16 H16 V18 Z M16,14 H8 V12 H16 V14 Z M13,9 V3.5 L18.5,9 H13 Z"
                                              Fill="#94A3B8" Width="22" Height="22" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Detalhes do atendimento" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{StaticResource CorTextoPrimario}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Clique em um registro na lista para inspecionar códigos, solução técnica, fotos e gerar recibo ou PDF."
                                               Foreground="{StaticResource CorTextoMudo}" FontSize="12.5" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Conteúdo do Atendimento Selecionado -->
                                <DockPanel x:Name="PainelDetalheConteudo" Visibility="Collapsed">
                                    <!-- Cabeçalho do Inspetor -->
                                    <Border DockPanel.Dock="Top" Background="#0F172A" CornerRadius="11,11,0,0" Padding="16,14">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <Border DockPanel.Dock="Left" x:Name="BadgeDetalhePago" Background="#134E4A" CornerRadius="6" Padding="8,2">
                                                    <TextBlock x:Name="TxtDetalhePago" Text="Pago" Foreground="#5EEAD4" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" x:Name="TxtDetalheValor" Text="R$ 0,00"
                                                           Foreground="#5EEAD4" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtDetalheTitulo" Text="ABC-1234" Foreground="#FFFFFF"
                                                       FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtDetalheSubtitulo" Text="Volkswagen Gol 2020" Foreground="#CBD5E1"
                                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtDetalheData" Text="19/11/2026" Foreground="#94A3B8"
                                                       FontSize="11.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rodapé de Ações do Inspetor -->
                                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="{StaticResource CorBordaSuave}"
                                            BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="12,10">
                                        <StackPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                                <Button x:Name="BtnEditarAtendimento" Content="Editar" Click="Editar_Click"
                                                        Style="{StaticResource BotaoPrimario}" MinHeight="32" Padding="8,5" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnRepetirAtendimento" Content="Novo p/ este" Click="RepetirAtendimento_Click"
                                                        Style="{StaticResource BotaoCompacto}" Margin="4,0,0,0"
                                                        ToolTip="Criar novo atendimento aproveitando os dados deste veículo/local"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                                <Button Content="Recibo WhatsApp" Click="ReciboWhatsApp_Click"
                                                        Style="{StaticResource BotaoCompacto}" Margin="0,0,4,0"/>
                                                <Button Content="Exportar PDF" Click="ExportarPdf_Click"
                                                        Style="{StaticResource BotaoCompacto}" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="2">
                                                <Button Content="Ficha técnica" Click="VerFichaAtendimento_Click"
                                                        Style="{StaticResource BotaoCompacto}" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnExcluirAtendimento" Content="Excluir" Click="Excluir_Click"
                                                        Style="{StaticResource BotaoPerigo}" MinHeight="30" Padding="8,4" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Corpo Rolável do Inspetor -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                                        <StackPanel x:Name="StackDetalheCampos"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3. WORKSPACE DO FICHÁRIO INTELIGENTE -->
                <Grid x:Name="PainelFichario" Margin="20,16,20,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BuscaFichario" Width="320" TextChanged="BuscaFichario_TextChanged"
                                         ToolTip="Filtrar modelos, marcas, fechaduras ou códigos no fichário"/>
                                <TextBlock x:Name="TxtResumoFichario" Text="Dê duplo clique em um item para filtrar os atendimentos."
                                           Foreground="{StaticResource CorTextoMudo}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12" Padding="0">
                        <Grid>
                            <DataGrid x:Name="GradeFicharioVeiculos" AutoGenerateColumns="False" BorderThickness="0"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                      MouseDoubleClick="GradeFicharioVeiculos_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="140"/>
                                    <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="190"/>
                                    <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="85"/>
                                    <DataGridTextColumn Header="Atendimentos" Binding="{Binding Servicos}" Width="105"/>
                                    <DataGridTextColumn Header="Último serviço" Binding="{Binding Ultimo}" Width="115"/>
                                    <DataGridTextColumn Header="Código da chave" Binding="{Binding CodigoChave}" Width="135"/>
                                    <DataGridTextColumn Header="Chip / Transponder" Binding="{Binding Chip}" Width="145"/>
                                    <DataGridTextColumn Header="Abertura / Observações" Binding="{Binding Abertura}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="GradeFicharioResidencial" AutoGenerateColumns="False" BorderThickness="0"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Visibility="Collapsed"
                                      MouseDoubleClick="GradeFicharioResidencial_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo de local" Binding="{Binding TipoLocal}" Width="140"/>
                                    <DataGridTextColumn Header="Ambiente / Porta" Binding="{Binding Ambiente}" Width="150"/>
                                    <DataGridTextColumn Header="Marca fechadura" Binding="{Binding MarcaFechadura}" Width="140"/>
                                    <DataGridTextColumn Header="Modelo fechadura" Binding="{Binding ModeloFechadura}" Width="150"/>
                                    <DataGridTextColumn Header="Cilindro / Chave" Binding="{Binding Cilindro}" Width="135"/>
                                    <DataGridTextColumn Header="Atendimentos" Binding="{Binding Servicos}" Width="100"/>
                                    <DataGridTextColumn Header="Último serviço" Binding="{Binding Ultimo}" Width="115"/>
                                    <DataGridTextColumn Header="Código da chave" Binding="{Binding CodigoChave}" Width="125"/>
                                    <DataGridTextColumn Header="Abertura / Observações" Binding="{Binding Abertura}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. WORKSPACE DE FICHAS TÉCNICAS E MANUAIS -->
                <Grid x:Name="PainelFichas" Margin="20,16,20,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BuscaFichas" Width="280" TextChanged="BuscaFichas_TextChanged" Margin="0,0,10,0"
                                         ToolTip="Pesquisar por marca, modelo, equipamento, chip, chave ou manual"/>
                                <Button Content="Ver ficha e manual" Click="VerManualFicha_Click" Margin="0,0,6,0"/>
                                <Button x:Name="BtnEditarFicha" Content="Editar / complementar" Click="EditarFicha_Click" Margin="0,0,6,0"/>
                                <Button x:Name="BtnNovoAtendimentoFicha" Content="+ Atendimento com ficha" Click="NovoServicoDaFicha_Click" Margin="0,0,6,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnNovaFicha" Content="+ Nova ficha" Click="NovaFicha_Click"
                                        Style="{StaticResource BotaoPrimario}" Margin="0,0,6,0"/>
                                <Button x:Name="BtnExcluirFicha" Content="Excluir" Click="ExcluirFicha_Click"
                                        Style="{StaticResource BotaoPerigo}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12" Padding="0">
                        <DataGrid x:Name="GradeFichas" AutoGenerateColumns="False" BorderThickness="0"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                  MouseDoubleClick="GradeFichas_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Origem" Binding="{Binding OrigemFormatada}" Width="130"/>
                                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="125"/>
                                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="170"/>
                                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="85"/>
                                <DataGridTextColumn Header="Equipamento" Binding="{Binding Equipamento}" Width="140"/>
                                <DataGridTextColumn Header="Sistema" Binding="{Binding Sistema}" Width="145"/>
                                <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="115"/>
                                <DataGridTextColumn Header="Chave" Binding="{Binding Chave}" Width="125"/>
                                <DataGridTextColumn Header="Manual" Binding="{Binding ManualFormatado}" Width="125"/>
                                <DataGridTextColumn Header="Confirmado" Binding="{Binding ConfirmadoFormatado}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 5. WORKSPACE DE CONFLITOS DE SINCRONIA -->
                <Grid x:Name="PainelConflitos" Margin="20,16,20,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Escolha qual versão manter para cada conflito. Se o servidor excluiu o registro, manter a versão deste PC recriará o registro."
                                       Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" FontSize="13"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Manter versão deste PC" Click="ManterConflito_Click" Style="{StaticResource BotaoPrimario}"/>
                                <Button Content="Aceitar versão do servidor" Click="AceitarConflito_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBordaSuave}"
                            BorderThickness="1" CornerRadius="12">
                        <DataGrid x:Name="GradeConflitos" AutoGenerateColumns="False" BorderThickness="0"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Entidade}" Width="140"/>
                                <DataGridTextColumn Header="Identificação / Placa" Binding="{Binding Placa}" Width="210"/>
                                <DataGridTextColumn Header="Situação no servidor" Binding="{Binding SituacaoRemota}" Width="220"/>
                                <DataGridTextColumn Header="Código do registro" Binding="{Binding Uuid}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Barra de Status Inferior -->
            <Border Grid.Row="2" Background="{StaticResource CorSuperficie}"
                    BorderBrush="{StaticResource CorBordaSuave}" BorderThickness="0,1,0,0"
                    Padding="24,8">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" x:Name="Status" VerticalAlignment="Center"
                               Foreground="{StaticResource CorTextoMudo}" FontSize="12"/>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtPendenciasRodape" Text=""
                               Foreground="{StaticResource CorTextoMudo}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
