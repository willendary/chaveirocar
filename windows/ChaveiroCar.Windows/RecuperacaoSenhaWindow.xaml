<Window x:Class="ChaveiroCar.Windows.RecuperacaoSenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Recuperar Senha"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Recuperar senha" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Solicite o código por e-mail e defina uma nova senha para sua conta."
                           Foreground="#FF94A3B8" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                CornerRadius="12" Margin="20,16,20,20" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="E-mail da conta" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <TextBox x:Name="Email"/>
                </StackPanel>

                <Button Grid.Row="1" x:Name="Solicitar" Content="Enviar código por e-mail"
                        Click="Solicitar_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                <Border Grid.Row="2" Height="1" Background="{StaticResource CorBorda}" Margin="0,0,0,16"/>

                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Código recebido no e-mail" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <TextBox x:Name="Token"/>
                    <TextBlock Text="Nova senha (mínimo 8 caracteres, letras e números)" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="NovaSenha"/>
                </StackPanel>

                <TextBlock Grid.Row="5" x:Name="Erro" Foreground="{StaticResource CorPerigo}"
                           FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fechar" IsCancel="True" Width="110" Margin="0,0,10,0"/>
                    <Button x:Name="Alterar" Content="Alterar senha" Style="{StaticResource BotaoPrimario}" Width="140" Click="Alterar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
