<Window x:Class="ChaveiroCar.Windows.AtendimentoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atendimento" Height="780" Width="840" MinHeight="640" MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,12">
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Tipo de atendimento" FontWeight="SemiBold"/>
                        <ComboBox x:Name="Segmento" SelectedIndex="0" SelectionChanged="Segmento_SelectionChanged">
                            <ComboBoxItem Content="Automotivo" Tag="AUTOMOTIVO"/>
                            <ComboBoxItem Content="Residencial" Tag="RESIDENCIAL"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Data do serviço" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DataServico"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel x:Name="PainelAutomotivo">
                    <TextBlock Text="Veículo" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Modelo *"/>
                            <TextBox x:Name="Modelo"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Placa (opcional)"/>
                            <TextBox x:Name="Placa"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Marca"/>
                            <TextBox x:Name="Marca"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Ano"/>
                            <TextBox x:Name="Ano"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Chassi (opcional)"/>
                            <TextBox x:Name="Chassi"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <StackPanel x:Name="PainelResidencial" Visibility="Collapsed">
                    <TextBlock Text="Local e fechadura" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Tipo de local *"/>
                            <ComboBox x:Name="TipoLocal" IsEditable="True">
                                <ComboBoxItem Content="Casa"/>
                                <ComboBoxItem Content="Apartamento"/>
                                <ComboBoxItem Content="Comércio"/>
                                <ComboBoxItem Content="Condomínio"/>
                                <ComboBoxItem Content="Portão"/>
                                <ComboBoxItem Content="Outro"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Ambiente / porta"/>
                            <ComboBox x:Name="AmbientePorta" IsEditable="True">
                                <ComboBoxItem Content="Porta principal"/>
                                <ComboBoxItem Content="Porta social"/>
                                <ComboBoxItem Content="Portão"/>
                                <ComboBoxItem Content="Quarto"/>
                                <ComboBoxItem Content="Escritório"/>
                                <ComboBoxItem Content="Gaveta / armário"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Marca da fechadura"/>
                            <ComboBox x:Name="MarcaFechadura" IsEditable="True">
                                <ComboBoxItem Content="Papaiz"/>
                                <ComboBoxItem Content="Pado"/>
                                <ComboBoxItem Content="Stam"/>
                                <ComboBoxItem Content="La Fonte"/>
                                <ComboBoxItem Content="Intelbras"/>
                                <ComboBoxItem Content="Yale"/>
                                <ComboBoxItem Content="Arouca"/>
                                <ComboBoxItem Content="Aliança"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Modelo da fechadura"/>
                            <TextBox x:Name="ModeloFechadura"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Cilindro / tipo de chave"/>
                            <ComboBox x:Name="TipoCilindro" IsEditable="True">
                                <ComboBoxItem Content="Yale / simples"/>
                                <ComboBoxItem Content="Tetra"/>
                                <ComboBoxItem Content="Multiponto"/>
                                <ComboBoxItem Content="Gorje"/>
                                <ComboBoxItem Content="Fechadura digital"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Endereço / referência (opcional)"/>
                            <TextBox x:Name="EnderecoLocal"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <TextBlock Text="Cliente" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Cliente"/>
                        <TextBox x:Name="ClienteNome"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Telefone"/>
                        <TextBox x:Name="ClienteTelefone"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Tipos de serviço" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ListBox x:Name="TiposServico" SelectionMode="Multiple" Height="126"/>

                <TextBlock Text="Detalhes do serviço" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/>
                <TextBlock Text="Defeito"/>
                <TextBox x:Name="Defeito" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Solução" Margin="0,6,0,0"/>
                <TextBox x:Name="Solucao" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Abertura / observações" Margin="0,6,0,0"/>
                <TextBox x:Name="Abertura" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Código da chave"/>
                        <TextBox x:Name="CodigoChave"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Código de configuração"/>
                        <TextBox x:Name="CodigoConfiguracao"/>
                    </StackPanel>
                    <StackPanel x:Name="PainelChipTransponder" Margin="0,0,8,8">
                        <TextBlock Text="Chip / transponder"/>
                        <TextBox x:Name="ChipTransponder"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Ferramenta"/>
                        <TextBox x:Name="Ferramenta"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Valor"/>
                        <TextBox x:Name="Valor"/>
                    </StackPanel>
                    <CheckBox x:Name="Pago" Content="Pago" VerticalAlignment="Center" Margin="0,10,0,8"/>
                </UniformGrid>

                <TextBlock Text="Fotos" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock Text="Fotos sincronizadas" Margin="0,0,0,4"/>
                <ListBox x:Name="FotosExistentes" Height="80" DisplayMemberPath="Legenda"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <Button Content="Abrir foto selecionada" Click="AbrirFoto_Click"/>
                    <Button Content="Anotar com setas…" Click="AnotarFotoExistente_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Categoria das novas fotos"/>
                        <ComboBox x:Name="CategoriaFoto" SelectedIndex="0">
                            <ComboBoxItem Content="Veículo / Fechadura" Tag="CARRO"/>
                            <ComboBoxItem Content="Procedimento" Tag="PROCEDIMENTO"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Legenda (opcional)"/>
                        <TextBox x:Name="LegendaFoto"/>
                    </StackPanel>
                </UniformGrid>
                <ListBox x:Name="FotosNovas" Height="90" DisplayMemberPath="Legenda"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Adicionar fotos…" Click="AdicionarFotos_Click"/>
                    <Button Content="Anotar foto nova com setas…" Click="AnotarFotoNova_Click" Margin="8,0,0,0"/>
                    <Button Content="Remover foto nova" Click="RemoverFoto_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Erro" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" LastChildFill="False">
            <Button Content="Cancelar" IsCancel="True" Width="100" Margin="0,0,8,0"/>
            <Button Content="Salvar" IsDefault="True" Width="100" Click="Salvar_Click"/>
        </DockPanel>
    </Grid>
</Window>
