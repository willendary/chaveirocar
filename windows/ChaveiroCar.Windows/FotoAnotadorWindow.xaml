<Window x:Class="ChaveiroCar.Windows.FotoAnotadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotar foto com setas" Height="680" Width="880" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#FF111827">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Arraste sobre a foto para desenhar uma seta indicando o componente."
                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDesfazer" Content="Desfazer" Click="Desfazer_Click" Margin="0,0,6,0" Padding="10,4"/>
                <Button x:Name="BtnRefazer" Content="Refazer" Click="Refazer_Click" Margin="0,0,6,0" Padding="10,4"/>
                <Button x:Name="BtnLimpar" Content="Limpar setas" Click="Limpar_Click" Padding="10,4"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FF1F2937" CornerRadius="8" Padding="8">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="AreaImagem"
                      MouseLeftButtonDown="AreaImagem_MouseLeftButtonDown"
                      MouseMove="AreaImagem_MouseMove"
                      MouseLeftButtonUp="AreaImagem_MouseLeftButtonUp"
                      Cursor="Cross">
                    <Image x:Name="ImagemBase" Stretch="None"/>
                    <Canvas x:Name="CamadaSetas" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Cor:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SeletorCor" Width="120" SelectedIndex="0" Margin="0,0,16,0">
                    <ComboBoxItem Content="Vermelho" Tag="#EF4444"/>
                    <ComboBoxItem Content="Amarelo" Tag="#FACC15"/>
                    <ComboBoxItem Content="Verde" Tag="#22C55E"/>
                    <ComboBoxItem Content="Azul claro" Tag="#38BDF8"/>
                    <ComboBoxItem Content="Branco" Tag="#FFFFFF"/>
                </ComboBox>

                <TextBlock Text="Espessura:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SeletorEspessura" Width="110" SelectedIndex="1">
                    <ComboBoxItem Content="Fina" Tag="3"/>
                    <ComboBoxItem Content="Média" Tag="5"/>
                    <ComboBoxItem Content="Grossa" Tag="8"/>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Width="100" Margin="0,0,8,0" Height="32"/>
                <Button Content="Salvar setas" IsDefault="True" Width="120" Height="32" Click="Salvar_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
