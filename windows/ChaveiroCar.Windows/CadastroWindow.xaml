<Window x:Class="ChaveiroCar.Windows.CadastroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta ChaveiroCar" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Criar conta" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Seu nome"/>
            <TextBox x:Name="Nome"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Empresa"/>
            <TextBox x:Name="Empresa"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="E-mail"/>
            <TextBox x:Name="Email"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Senha (mínimo 8 caracteres, com letras e números)"/>
            <PasswordBox x:Name="Senha"/>
        </StackPanel>
        <TextBlock Grid.Row="6" x:Name="Erro" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Width="100" Margin="0,0,8,0"/>
            <Button x:Name="Criar" Content="Criar conta" Width="110" Click="Criar_Click"/>
        </StackPanel>
    </Grid>
</Window>
