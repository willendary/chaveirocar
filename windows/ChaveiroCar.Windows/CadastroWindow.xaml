<Window x:Class="ChaveiroCar.Windows.CadastroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Criar Conta"
        Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CorFundoJanela}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Criar conta no ChaveiroCar" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Cadastre você e sua chaveiro para sincronizar atendimentos na nuvem."
                           Foreground="#FF94A3B8" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                CornerRadius="12" Margin="20,16,20,20" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Seu nome completo" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <TextBox x:Name="Nome"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Nome da empresa / chaveiro" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <TextBox x:Name="Empresa"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="E-mail" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <TextBox x:Name="Email"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Senha (mínimo 8 caracteres, com letras e números)" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="Senha"/>
                </StackPanel>

                <TextBlock Grid.Row="5" x:Name="Erro" Foreground="{StaticResource CorPerigo}"
                           FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" IsCancel="True" Width="110" Margin="0,0,10,0"/>
                    <Button x:Name="Criar" Content="Criar conta" Style="{StaticResource BotaoPrimario}" Width="140" Click="Criar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
