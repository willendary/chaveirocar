<Window x:Class="ChaveiroCar.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaveiroCar — Acesso à Conta"
        Height="580" Width="460"
        Background="{StaticResource CorFundoApp}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Institucional Azul Petróleo + Jade -->
        <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="32,26,32,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#134E4A" BorderBrush="#0D9488" BorderThickness="1.5" Margin="0,0,12,0">
                        <Path Data="M7,14 A3,3 0 1,1 7,8 A3,3 0 1,1 7,14 M10,11 L20,11 L20,14 L17,14 L17,11"
                              Stroke="#2DD4BF" StrokeThickness="2" Stretch="Uniform" Margin="7"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CHAVEIROCAR" FontSize="11" FontWeight="Bold" Foreground="#2DD4BF"/>
                        <TextBlock Text="ChaveiroCar Desktop" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Acesse sua conta para consultar e sincronizar atendimentos automotivos, residenciais e fichas técnicas."
                           Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card de Autenticação -->
        <Border Grid.Row="1" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBordaSuave}" BorderThickness="1"
                CornerRadius="12" Margin="24,20,24,24" Padding="26,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Botão Entrar com Google (via navegador OAuth) -->
                <Button Grid.Row="0" x:Name="BotaoGoogle" Height="42" Click="EntrarGoogle_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#EA4335" Margin="0,0,10,0">
                            <TextBlock Text="G" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TextoBotaoGoogle" Text="Continuar com Google" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Divisor -->
                <Grid Grid.Row="1" Margin="0,16,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="ou entre com seu e-mail" Foreground="#64748B" FontSize="12" Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
                </Grid>

                <!-- E-mail -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="E-mail profissional" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="Email"/>
                </StackPanel>

                <!-- Senha -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Senha" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="Senha" KeyDown="Senha_KeyDown"/>
                </StackPanel>

                <!-- Mensagem de Erro / Status -->
                <TextBlock Grid.Row="4" x:Name="Erro" Foreground="{StaticResource CorPerigo}"
                           FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- Botão Principal Entrar -->
                <Button Grid.Row="6" x:Name="BotaoEntrar" Content="Entrar na conta"
                        Style="{StaticResource BotaoPrimario}" Height="42"
                        IsDefault="True" Click="Entrar_Click"/>

                <!-- Links Secundários -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Criar conta" Style="{StaticResource BotaoLink}" Click="CriarConta_Click"/>
                    <TextBlock Text="·" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Content="Esqueci a senha" Style="{StaticResource BotaoLink}" Click="RecuperarSenha_Click"/>
                    <TextBlock Text="·" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Content="Tenho convite" Style="{StaticResource BotaoLink}" Click="AceitarConvite_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
