<Window x:Class="ChaveiroCar.Windows.ConviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aceitar convite" Height="540" Width="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Aceitar convite" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="Token" MinWidth="330" VerticalContentAlignment="Center"/>
            <Button x:Name="Verificar" Content="Verificar" Click="Verificar_Click" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="ConviteInfo" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="3" x:Name="Modos" Visibility="Collapsed">
            <RadioButton x:Name="CriarConta" Content="Ainda não tenho conta" GroupName="conta" IsChecked="True" Checked="Modo_Checked"/>
            <RadioButton x:Name="UsarConta" Content="Já tenho conta" GroupName="conta" Checked="Modo_Checked"/>
        </StackPanel>
        <StackPanel Grid.Row="4" x:Name="DadosContaNova" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Seu nome"/>
            <TextBox x:Name="Nome"/>
            <TextBlock Text="Crie uma senha (mínimo 8 caracteres, com letras e números)" Margin="0,8,0,0"/>
            <PasswordBox x:Name="SenhaNova"/>
        </StackPanel>
        <StackPanel Grid.Row="4" x:Name="DadosContaExistente" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="E-mail da conta"/>
            <TextBox x:Name="Email"/>
            <TextBlock Text="Senha" Margin="0,8,0,0"/>
            <PasswordBox x:Name="SenhaExistente"/>
        </StackPanel>
        <TextBlock Grid.Row="6" x:Name="Erro" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fechar" IsCancel="True" Width="100" Margin="0,0,8,0"/>
            <Button x:Name="Aceitar" Content="Aceitar convite" Width="120" Click="Aceitar_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
